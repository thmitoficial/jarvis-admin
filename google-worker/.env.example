# Copie para .env e preencha com as credenciais do Google Cloud Console.

# Credenciais OAuth do Google Cloud Console
# Console: https://console.cloud.google.com/apis/credentials
# Crie um OAuth Client ID tipo "Web application".
# Authorized redirect URIs: http://localhost:8787/oauth/callback
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# Porta do worker
PORT=8787

# Token secreto compartilhado com a API jarvis-admin.
# A API envia este token no header X-Worker-Token.
# Gere um aleatório forte: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
WORKER_API_TOKEN=troque-por-um-token-forte

# Refresh token (preenchido após o primeiro /oauth/start)
# Após autorizar uma vez, o worker salva aqui o refresh token.
# Você pode apagar este arquivo e re-autorizar quando quiser.
GOOGLE_REFRESH_TOKEN=

# Escopos solicitados (não alterar)
# https://www.googleapis.com/auth/calendar.events
# https://www.googleapis.com/auth/calendar.readonly
# https://www.googleapis.com/auth/gmail.readonly
# https://www.googleapis.com/auth/gmail.send
