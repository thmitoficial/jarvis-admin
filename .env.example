# Copie para .env e preencha.

# Servidor
PORT=3000

# E-mail (SMTP) — usado pelo endpoint /admin/email/enviar quando GOOGLE_WEBHOOK_URL está vazio
# Funciona com Gmail (app password), SendGrid SMTP, SES, Mailtrap, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password
SMTP_FROM=seu-email@gmail.com

# Worker Google (recomendado) — leitura + envio via Gmail OAuth, rastreável na conta
# Inicie o worker em google-worker/ (npm install && npm start), autorize em /oauth/start,
# copie o refresh token exibido para o .env do worker, e preencha abaixo:
GOOGLE_WEBHOOK_URL=http://localhost:8787
WORKER_API_TOKEN=troque-por-um-token-forte-igual-ao-do-worker

# NF-e: NÃO EXISTE API pública gratuita para consulta por chave de acesso.
# Para habilitar NF-e real, plugue um provedor pago (ex.: nfse.io, Tech4Flex).
NFE_PROVIDER_URL=
NFE_PROVIDER_TOKEN=
