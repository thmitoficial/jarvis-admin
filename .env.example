# Copie para .env e preencha.

# Servidor
PORT=3000

# E-mail (SMTP) — usado pelo endpoint /email/send
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password
SMTP_FROM=seu-email@gmail.com

# NF-e: NÃO EXISTE API pública gratuita para consulta por chave de acesso.
NFE_PROVIDER_URL=
NFE_PROVIDER_TOKEN=

# Google Calendar / Gmail (opcional — via webhook autenticado)
GOOGLE_WEBHOOK_URL=
